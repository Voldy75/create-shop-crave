# Google Gemini API key for AI chat
GOOGLE_AI_API_KEY=

# Google Maps API key (used server-side for Places API)
GOOGLE_MAPS_API_KEY=

# Google Maps API key (used client-side for map rendering)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Twilio WhatsApp Sandbox (Phase 6 notifications) ---
# Get these from https://console.twilio.com/ → Account → API keys & tokens
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio Sandbox sender — same for all sandbox users
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your sandbox join code's second word (the "join <word>" phrase) — used in opt-in UI
TWILIO_SANDBOX_JOIN_CODE=

# --- Web Push VAPID keys (Phase 6 notifications) ---
# Generate via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact mailto: shown to push services in case of delivery issues
VAPID_SUBJECT=mailto:you@example.com

# --- Daily nudge cron (Phase 6) ---
# Random secret string; required as ?token= on /api/cron/daily-nudge
CRON_SECRET=

# --- Swiggy MCP integration (Phase 7) ---
# Apply for credentials at https://mcp.swiggy.com/builders/access/
# Local dev: per Swiggy docs, "no access needed until prod" — see /builders/docs/start/developer/
SWIGGY_CLIENT_ID=
# Optional: override canonical origin for OAuth redirect_uri (defaults to req origin)
NEXT_PUBLIC_SITE_URL=
