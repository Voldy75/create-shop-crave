# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# capacitor native projects — regenerated by `npx cap add`; the current ios/
# has a localhost dev URL + dev-only ATS exception baked in. Regenerate against
# the pinned production alias before any distributable build. Do not commit.
/ios/
/android/

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
.claude/
